# ---------------------------------------------------------------------------
# NavIC CBTMS example configuration
#
# Copy to .env (or export these variables through your process manager) and
# replace every placeholder.  Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | production
APP_ENV=development

# SQLite is stored in ~/.local/share/navic/navic.sqlite3 by default.
# NAVIC_DATA_DIR=/path/to/navic-data
# DATABASE_URL=sqlite:////absolute/path/navic.sqlite3

# Stable signing secret for legacy bearer tokens.  Required in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
JWT_TTL_SECONDS=3600

# Salt used when hashing client IP addresses for rate-limit/audit rows.
# Falls back to JWT_SECRET when unset.  Use a separate long random value.
AUTH_IP_SALT=replace-with-another-long-random-value

# --- Browser session / cookies --------------------------------------------
# Public origin of the React app, used to build magic links and validate
# same-origin writes.  Must match the browser origin exactly.
FRONTEND_URL=http://localhost:5173
# Local FastAPI listener and Vite proxy target. Set the public API URL in production.
BACKEND_URL=http://localhost:8000
# Optional public API origin used by scannable bus-pass verification QR codes.
# PUBLIC_API_URL=https://api.navic.example.edu

# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In development cookie_secure defaults to false.  In production it defaults
# to true; keep it true whenever the site is served over HTTPS.
# COOKIE_SECURE=true
# lax (default) | strict | none  (none requires Secure)
COOKIE_SAMESITE=lax
# Optional parent-domain cookie scope, e.g. .example.edu
# COOKIE_DOMAIN=

MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_MINUTES=720
MAGIC_LINK_IP_LIMIT=8
MAGIC_LINK_EMAIL_LIMIT=3
MAGIC_LINK_WINDOW_SECONDS=600

# Temporary local demo only. The backend ignores this unless APP_ENV is a
# development value. Never enable for a shared or production deployment.
DEMO_AUTH_BYPASS=false

# Enable built-in demo simulation (admin only). Only works in development mode
# or when explicitly enabled. Never enable for a shared or production deployment.
DEMO_SIMULATION_ENABLED=false

# --- Email delivery --------------------------------------------------------
# resend | smtp | console
#   resend  - HTTPS API (recommended; no extra Python package required)
#   smtp    - any SMTP relay, or Gmail app-password SMTP for a small demo
#   console - DEVELOPMENT ONLY; writes messages to EMAIL_CAPTURE_FILE
EMAIL_PROVIDER=console
EMAIL_FROM="NavIC CBTMS <no-reply@example.edu>"
SMTP_FROM_EMAIL=no-reply@example.edu
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
USN_REGEX=^[A-Za-z0-9][A-Za-z0-9/-]{2,31}$

# Resend (https://resend.com): create an API key and verify your sending
# domain (or use their onboarding domain while testing).
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_API_URL=https://api.resend.com/emails

# SMTP fallback.  For Gmail, create an App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords); normal passwords are
# rejected.  Port 587 uses STARTTLS, port 465 uses implicit TLS.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_STARTTLS=true
# SMTP_USE_TLS=true
# SMTP_SSL=false
# SMTP_TIMEOUT_SECONDS=15

# Development mail capture.  Contains real sign-in links, so keep it local,
# git-ignored, and never serve it publicly.
EMAIL_CAPTURE_FILE=dev-mail.jsonl

# --- Initial administrator -------------------------------------------------
ADMIN_EMAIL=admin@example.invalid
# Generate with: .venv/bin/python -c 'from getpass import getpass; from navic_tcp.security import hash_password; print(hash_password(getpass()))'
# Paste the resulting scrypt hash here. Never store the plaintext password in
# source control or expose this hash through the frontend.
ADMIN_PASSWORD_HASH=

# --- Telemetry receiver / simulator ---------------------------------------
TCP_ENABLED=true
TCP_HOST=127.0.0.1
TCP_PORT=5000
TCP_IDLE_TIMEOUT_SECONDS=0
DEVICE_REGISTRY=config/devices.demo.json

# Optional shared device secret.  When set, the server rejects frames without
# a matching auth_token; the simulator sends it automatically.
# DEVICE_AUTH_TOKEN=replace-with-a-device-secret

# Optional thresholds mirrored into system settings.
# OVERSPEED_KMH=80
# STOPPAGE_MINUTES=5
# DEVICE_OFFLINE_SECONDS=300

# Optional student-service display configuration.
# COLLEGE_NAME=NavIC College
# CBTMS_SUPPORT_EMAIL=transport@example.edu
# CBTMS_SUPPORT_PHONE=

# Optional built SPA directory (defaults to frontend/dist).
# FRONTEND_DIST=frontend/vite/build
