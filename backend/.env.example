# NavIC backend environment template
#
# Copy this file to the project-root `.env` (the backend loads it from there) or
# export the variables through your process manager. Never commit real secrets.
#
# See the full annotated template in the repository-root `.env.example`.

APP_ENV=development

# SQLite is the local default and is stored in the user's NavIC data directory.
# Set NAVIC_DATA_DIR to change that directory, or DATABASE_URL to use a custom
# local SQLite file. A previous repository-local navic_dev.db is imported once.
# NAVIC_DATA_DIR=/home/you/.local/share/navic
# DATABASE_URL=sqlite:////home/you/.local/share/navic/navic.sqlite3

JWT_SECRET=replace-with-a-long-random-value
JWT_TTL_SECONDS=3600
AUTH_IP_SALT=replace-with-another-long-random-value

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_MINUTES=720
DEMO_AUTH_BYPASS=false

EMAIL_PROVIDER=console
EMAIL_FROM="NavIC CBTMS <no-reply@example.edu>"
SMTP_FROM_EMAIL=no-reply@example.edu
EMAIL_CAPTURE_FILE=dev-mail.jsonl
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
USN_REGEX=^[A-Za-z0-9][A-Za-z0-9/-]{2,31}$
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD_HASH=

TCP_ENABLED=true
TCP_HOST=127.0.0.1
TCP_PORT=5000
DEVICE_REGISTRY=config/devices.demo.json
# DEVICE_AUTH_TOKEN=replace-with-a-device-secret

# Optional: port and serving host for backend/run.py.
# PORT=8000
# API_HOST=0.0.0.0
# FRONTEND_DIST=frontend/vite/build
